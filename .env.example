# SkillBridge Environment Configuration
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/skillbridge
CLIENT_URL=http://localhost:5173
JWT_SECRET=skillbridge-super-secret-dev-jwt-key-2026
REDIS_URL=redis://localhost:6379

# Firebase Admin Configuration (Optional in local mock-auth mode)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Feature Flags (Stage 1 has these disabled; enabled in Stage 2)
FEATURE_PHASE_2_JOBS=false
FEATURE_PHASE_2_STARTUPS=false
FEATURE_PHASE_2_MENTORSHIP=false
FEATURE_AI_MATCHING=false

# AI & Embeddings
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Email Notification Provider (Nodemailer / SMTP)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=notifications@skillbridge.edu

# Sentry Monitoring
SENTRY_DSN=
