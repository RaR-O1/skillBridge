{
  "info": {
    "name": "SkillBridge API Collection",
    "description": "Comprehensive API collection for SkillBridge Modular Monolith covering Stage 1 flows across all user roles.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "studentToken",
      "value": ""
    },
    {
      "key": "businessToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/../health"
      }
    },
    {
      "name": "Auth - Dev Login (Student)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"aarav.sharma@iitd.ac.in\",\n  \"role\": \"student\",\n  \"name\": \"Aarav Sharma\"\n}"
        }
      }
    },
    {
      "name": "Auth - Dev Login (Local Business)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"owner@kaveribakery.com\",\n  \"role\": \"local_business\",\n  \"name\": \"Ramesh Verma\"\n}"
        }
      }
    },
    {
      "name": "Auth - Dev Login (Admin)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/login",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@skillbridge.edu\",\n  \"role\": \"admin\",\n  \"name\": \"SkillBridge Admin\"\n}"
        }
      }
    },
    {
      "name": "Auth - Send College Verification Code",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/verify-college/send",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"collegeEmail\": \"student@stanford.edu\"\n}"
        }
      }
    },
    {
      "name": "Auth - Confirm College Verification Code",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/auth/verify-college/confirm",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"collegeEmail\": \"student@stanford.edu\",\n  \"code\": \"123456\"\n}"
        }
      }
    },
    {
      "name": "Teams - List All Teams",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/teams?status=open"
      }
    },
    {
      "name": "Teams - Create Squad Request",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/teams",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Web3 Solana Hackathon\",\n  \"description\": \"Building cross-border student remittances on Solana.\",\n  \"hackathonName\": \"Solana Summer Camp\",\n  \"skillsNeeded\": [\"Rust\", \"React\", \"Tailwind\"],\n  \"teamSize\": 3,\n  \"deadline\": \"2026-11-01T18:00:00Z\"\n}"
        }
      }
    },
    {
      "name": "Projects - List Freelance Projects",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/projects?status=open"
      }
    },
    {
      "name": "Projects - Create Project (Business)",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/projects",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{businessToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Coffee Shop Mobile Ordering Web App\",\n  \"description\": \"Need responsive menu and WhatsApp order settlement link.\",\n  \"category\": \"Web Development\",\n  \"requiredSkills\": [\"React\", \"Tailwind CSS\"],\n  \"budgetINR\": 12000,\n  \"deadline\": \"2026-11-15T00:00:00Z\"\n}"
        }
      }
    },
    {
      "name": "Agreements - Confirm Price Agreement Card",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/agreements/:id/confirm",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"confirmed\": true\n}"
        }
      }
    },
    {
      "name": "Agreements - Student Confirms Payment Received",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/agreements/confirm-payment/:projectId",
        "header": [
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ]
      }
    },
    {
      "name": "Reports - Submit Dispute / Payment Issue",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/reports",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{studentToken}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": \"payment_not_received\",\n  \"description\": \"Work approved 5 days ago, client delayed direct settlement.\"\n}"
        }
      }
    },
    {
      "name": "Admin - View Queue & Audit Logs",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/admin/audit-logs",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" }
        ]
      }
    }
  ]
}
